{{- /* Full-text RSS. Home feed: posts, series parts and notes. Section/tag feeds: their pages. */ -}}
{{- $pages := slice -}}
{{- if .IsHome -}}
  {{- $pages = where site.RegularPages "Section" "in" (slice "posts" "series" "notes") -}}
{{- else if eq .Kind "term" -}}
  {{- $pages = .Pages -}}
{{- else -}}
  {{- $pages = .RegularPagesRecursive -}}
{{- end -}}
{{- $pages = where $pages "Params.hidden" "!=" true -}}
{{- $pages = first (site.Config.Services.RSS.Limit | default 40) $pages.ByDate.Reverse -}}
{{- $base := site.BaseURL -}}
{{- printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
  <channel>
    <title>{{ if .IsHome }}{{ site.Title }}{{ else }}{{ .Title }} · {{ site.Title }}{{ end }}</title>
    <link>{{ .Permalink }}</link>
    <description>{{ .Description | default site.Params.description }}</description>
    <language>{{ site.Language.Lang }}</language>
    {{- with index $pages 0 }}
    <lastBuildDate>{{ .Date.Format "Mon, 02 Jan 2006 15:04:05 -0700" | safeHTML }}</lastBuildDate>
    {{- end }}
    {{- with .OutputFormats.Get "rss" }}
    {{ printf "<atom:link href=%q rel=\"self\" type=\"application/rss+xml\"/>" .Permalink | safeHTML }}
    {{- end }}
    {{- range $pages }}
    {{- $p := . }}
    <item>
      <title>{{ with partial "series-of.html" $p }}[{{ partial "series-slug.html" . }}/{{ partial "part.html" $p }}] {{ end }}{{ .Title }}</title>
      <link>{{ .Permalink }}</link>
      <pubDate>{{ .Date.Format "Mon, 02 Jan 2006 15:04:05 -0700" | safeHTML }}</pubDate>
      <guid>{{ .Permalink }}</guid>
      <description>{{ replaceRE `(src|href)="/` (printf `$1="%s` $base) .Content | transform.XMLEscape | safeHTML }}</description>
    </item>
    {{- end }}
  </channel>
</rss>
